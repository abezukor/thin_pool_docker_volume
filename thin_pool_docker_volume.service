[Unit]
Description=Docker volume plugin backed by an LVM thin pool
Documentation=file:///usr/share/doc/thin_pool_docker_volume/README
After=lvm2-lvmdbusd.service docker.service
Requires=lvm2-lvmdbusd.service
PartOf=docker.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/thin_pool_docker_volume
ExecStart=/usr/bin/thin_pool_docker_volume
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
